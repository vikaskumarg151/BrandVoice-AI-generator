# GEMINI_API_KEY: Injected by AI Studio if using Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Backend OpenAI API key for brand voice & tweet generation
# If not provided, the application runs seamlessly in clearly marked Demo Mode
OPENAI_API_KEY="your-openai-api-key-here"

# OPENAI_MODEL: Model to use for generation (defaults to gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: Host URL
APP_URL="http://localhost:3000"
