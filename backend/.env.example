# Backend Environment Configuration
# OPENAI_API_KEY: Required for live OpenAI API calls. If unset, BrandVoice AI runs in Demo Mode.
OPENAI_API_KEY="your-openai-api-key-here"

# OPENAI_MODEL: The model name to use for OpenAI generation (defaults to gpt-4o-mini or gpt-4o)
OPENAI_MODEL="gpt-4o-mini"

# PORT: Port on which the FastAPI server listens (default: 8000)
PORT="8000"

# ENVIRONMENT: development or production
ENVIRONMENT="development"
